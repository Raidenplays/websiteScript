{
 "signup": "      <h1 class=\"pagehead\">SIGN UP FREE!!!</h1>\n      <p class=\"pagesub\">Make an account so you can post in the shoutbox and vote in polls. No email needed!</p>\n\n      <div class=\"box\">\n        <h2>&#9733; CREATE YOUR ACCOUNT</h2>\n        <div class=\"in\">\n          <div id=\"signedin\" style=\"display:none\">You're already logged in! <a href=\"/account\">Go to My Account &raquo;</a></div>\n          <form id=\"signupform\" class=\"form\">\n            <label>Username <span class=\"hint\">(3-20 letters, numbers or _ &mdash; everyone can see this)</span></label>\n            <input name=\"username\" autocomplete=\"username\" maxlength=\"20\" required pattern=\"[A-Za-z0-9_]{3,20}\">\n            <label>Password <span class=\"hint\">(at least 8 characters)</span></label>\n            <input type=\"password\" name=\"password\" autocomplete=\"new-password\" minlength=\"8\" maxlength=\"128\" required>\n            <label>Password again</label>\n            <input type=\"password\" name=\"password2\" autocomplete=\"new-password\" minlength=\"8\" maxlength=\"128\" required>\n            <br><button class=\"btn g\" type=\"submit\">Sign Me Up!</button>\n            <div class=\"msg\" id=\"signupmsg\"></div>\n            <p class=\"hint\">There's no email on your account, so <b>don't forget your password</b>. If you do, ask Raiden for help.</p>\n          </form>\n        </div>\n      </div>",
 "account": "      <h1 class=\"pagehead\">MY ACCOUNT</h1>\n\n      <div id=\"acct-out\" style=\"display:none\" class=\"box\">\n        <h2>NOT LOGGED IN</h2>\n        <div class=\"in\">Log in at the top of the page, or <a href=\"/signup\">sign up FREE!</a></div>\n      </div>\n\n      <div id=\"acct-in\" style=\"display:none\">\n        <p class=\"pagesub\">Logged in as <b id=\"acct-name\"></b></p>\n        <div class=\"box\">\n          <h2>CHANGE PASSWORD</h2>\n          <div class=\"in\">\n            <form id=\"pwform\" class=\"form\">\n              <label>Current password</label>\n              <input type=\"password\" name=\"current\" autocomplete=\"current-password\" maxlength=\"128\" required>\n              <label>New password <span class=\"hint\">(at least 8 characters)</span></label>\n              <input type=\"password\" name=\"new\" autocomplete=\"new-password\" minlength=\"8\" maxlength=\"128\" required>\n              <label>New password again</label>\n              <input type=\"password\" name=\"new2\" autocomplete=\"new-password\" minlength=\"8\" maxlength=\"128\" required>\n              <br><button class=\"btn g\" type=\"submit\">Change Password</button>\n              <div class=\"msg\" id=\"pwmsg\"></div>\n            </form>\n          </div>\n        </div>\n\n        <div class=\"box\">\n          <h2 class=\"bk\">LOG OUT</h2>\n          <div class=\"in\"><button class=\"btn\" id=\"logoutbtn\" type=\"button\">Log out</button></div>\n        </div>\n\n        <div class=\"box\">\n          <h2 class=\"bk\">DELETE ACCOUNT</h2>\n          <div class=\"in\">\n            <form id=\"delform\" class=\"form\">\n              This deletes your account, your shouts and your poll votes forever.\n              <label>Type your password to confirm</label>\n              <input type=\"password\" name=\"password\" autocomplete=\"current-password\" maxlength=\"128\" required>\n              <br><button class=\"btn danger\" type=\"submit\">Delete My Account</button>\n              <div class=\"msg\" id=\"delmsg\"></div>\n            </form>\n          </div>\n        </div>\n      </div>",
 "admin": "      <h1 class=\"pagehead\">ADMIN</h1>\n\n      <div id=\"admin-no\" style=\"display:none\" class=\"box\">\n        <h2>ADMINS ONLY</h2>\n        <div class=\"in\">You need to be logged in as an admin to see this page.</div>\n      </div>\n\n      <div id=\"admin-yes\" style=\"display:none\">\n        <p class=\"pagesub\">Delete any shout with the red &times; in the shoutbox.</p>\n\n        <div class=\"box\">\n          <h2>UPLOAD A PIC</h2>\n          <div class=\"in\">\n            <form id=\"picform\" class=\"form\">\n              <label>Image <span class=\"hint\">(PNG, JPG, GIF or WEBP, max 10 MB)</span></label>\n              <input type=\"file\" name=\"file\" accept=\"image/png,image/jpeg,image/gif,image/webp\" required>\n              <label>Caption</label>\n              <input name=\"caption\" maxlength=\"60\">\n              <br><button class=\"btn g\" type=\"submit\">Upload</button>\n              <div class=\"msg\" id=\"picmsg\"></div>\n            </form>\n            <div class=\"adminpics\" id=\"adminpics\"></div>\n          </div>\n        </div>\n\n        <div class=\"box\">\n          <h2 class=\"or\">NEW POLL</h2>\n          <div class=\"in\">\n            <form id=\"pollform\" class=\"form\">\n              <label>Question</label>\n              <input name=\"question\" maxlength=\"120\" required>\n              <label>Options <span class=\"hint\">(2 to 6, leave extras blank)</span></label>\n              <input name=\"opt\" maxlength=\"60\" required><br>\n              <input name=\"opt\" maxlength=\"60\" required><br>\n              <input name=\"opt\" maxlength=\"60\"><br>\n              <input name=\"opt\" maxlength=\"60\"><br>\n              <input name=\"opt\" maxlength=\"60\"><br>\n              <input name=\"opt\" maxlength=\"60\">\n              <br><button class=\"btn g\" type=\"submit\">Start Poll</button>\n              <span class=\"hint\">(this replaces the current poll)</span>\n              <div class=\"msg\" id=\"pollmsg\"></div>\n            </form>\n          </div>\n        </div>\n\n        <div class=\"box\">\n          <h2 class=\"bk\">USERS</h2>\n          <div class=\"in\"><table class=\"users\" id=\"users\"></table></div>\n        </div>\n      </div>",
 "404": "      <h1 class=\"pagehead\">404!!! PAGE NOT FOUND</h1>\n      <p class=\"pagesub\">Something took this page... and it wasn't me.</p>\n      <div class=\"box\"><h2>&#9760; UH OH</h2><div class=\"in\"><a href=\"/\">Get back home before it finds you &raquo;</a></div></div>"
}