# Copy this file to .env and fill it in.

# The exact address people use to reach the site (no slash at the end).
SITE_ORIGIN=https://raidenbrundin.com

# Keep this at 1 in real use (cookies only sent over HTTPS). Only set 0 for testing on your own computer.
COOKIE_SECURE=1

# 1 = the site is behind a Cloudflare Tunnel, so use Cloudflare's real-visitor-IP header for rate limits.
TRUST_CLOUDFLARE=1

# Links shown on the site. Leave any of these empty and that link/button just disappears.
CONTACT_EMAIL=
LINKEDIN_URL=
GITHUB_URL=
DISCORD_INVITE=
SLINKGRENADE_URL=

# Optional robot check on the sign-up page (free). Cloudflare dashboard > Turnstile > Add widget for your domain.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
